<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.VentaController"
      spacing="0" style="-fx-background-color: #f0f2f5;">

    <!-- TOPBAR -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>
        <Label text="🧾 Ventas" styleClass="topbar-title"/>
    </HBox>

    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS"
             tabClosingPolicy="UNAVAILABLE"
             style="-fx-background-color: #f0f2f5;">
        <!-- PESTAÑA 1: NUEVA VENTA -->
        <Tab text="➕ Nueva Venta">
            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="16" bottom="16" left="16" right="16"/>
                </padding>

                <!-- PANEL IZQUIERDO -->
                <ScrollPane fitToWidth="true"
                            prefWidth="300" minWidth="300" maxWidth="300"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <VBox spacing="14">

                        <!-- Card datos de la venta -->
                        <VBox styleClass="card" spacing="10">
                            <Label text="📋 Datos de la venta"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"/>
                            <Separator/>

                            <VBox spacing="4">
                                <Label text="N° Comprobante" styleClass="label-field"/>
                                <TextField fx:id="txtNumeroComprobante"
                                           disable="true"
                                           style="-fx-background-color: #f0f0f0;"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Tipo Comprobante *" styleClass="label-field"/>
                                <ComboBox fx:id="cbTipoComprobante"
                                          maxWidth="Infinity"
                                          promptText="Boleta o Factura"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Cliente *" styleClass="label-field"/>
                                <ComboBox fx:id="cbCliente"
                                          maxWidth="Infinity"
                                          promptText="Busca por nombre o documento..."/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Método de Pago *" styleClass="label-field"/>
                                <ComboBox fx:id="cbMetodoPago"
                                          maxWidth="Infinity"
                                          promptText="Selecciona método"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Empleado" styleClass="label-field"/>
                                <TextField fx:id="txtEmpleado"
                                           disable="true"
                                           style="-fx-background-color: #f0f0f0;"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Fecha" styleClass="label-field"/>
                                <TextField fx:id="txtFecha"
                                           disable="true"
                                           style="-fx-background-color: #f0f0f0;"/>
                            </VBox>
                        </VBox>

                        <!-- Card agregar producto -->
                        <VBox styleClass="card" spacing="10">
                            <Label text="🔍 Agregar producto"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"/>
                            <Separator/>

                            <VBox spacing="4">
                                <Label text="Producto" styleClass="label-field"/>
                                <ComboBox fx:id="cbProducto"
                                          maxWidth="Infinity"
                                          promptText="Busca por nombre o ID..."/>
                            </VBox>

                            <!-- Muestra el stock disponible del producto elegido -->
                            <Label fx:id="lblStockDisponible"
                                   text=""
                                   style="-fx-font-size: 11px; -fx-text-fill: #6c757d;
                                          -fx-font-style: italic;"/>

                            <VBox spacing="4">
                                <Label text="Cantidad *" styleClass="label-field"/>
                                <TextField fx:id="txtCantidad" promptText="Ej: 1"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Precio unitario (S/) *" styleClass="label-field"/>
                                <TextField fx:id="txtPrecioUnitario" promptText="0.00"/>
                            </VBox>

                            <Button text="➕ Agregar al detalle"
                                    onAction="#agregarProducto"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #4361ee;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 8;
                                           -fx-padding: 8 16;
                                           -fx-cursor: hand;
                                           -fx-font-weight: bold;"/>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- PANEL DERECHO -->
                <!-- PANEL DERECHO -->
                <VBox styleClass="card" spacing="10"
                      HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

                    <Label text="🛒 Detalle de la venta"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                  -fx-text-fill: #1a1a2e;"/>
                    <Separator/>

                    <!-- Tabla crece con la pantalla pero el resumen
                         siempre queda visible gracias a VBox.vgrow="ALWAYS"
                         solo en la tabla y no en el resumen -->
                    <TableView fx:id="tablaDetalle" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCodigo"
                                         text="Código" prefWidth="90"/>
                            <TableColumn fx:id="colProducto"
                                         text="Producto" prefWidth="160"/>
                            <TableColumn fx:id="colCantidad"
                                         text="Cantidad" prefWidth="70"/>
                            <TableColumn fx:id="colPrecioUnit"
                                         text="P. Unitario" prefWidth="90"/>
                            <TableColumn fx:id="colSubtotal"
                                         text="Subtotal" prefWidth="90"/>
                            <TableColumn fx:id="colQuitarDet"
                                         text="" prefWidth="50"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <Separator/>

                    <!-- Resumen: NO tiene vgrow, siempre visible -->
                    <VBox spacing="5" style="-fx-padding: 4 0;">

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="Op. Gravada:"
                                   style="-fx-font-size: 12px;
                          -fx-text-fill: #6c757d;"/>
                            <Label fx:id="lblBaseImponible" text="S/ 0.00"
                                   style="-fx-font-size: 12px;
                          -fx-text-fill: #1a1a2e;"
                                   prefWidth="120" alignment="CENTER_RIGHT"/>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="I.G.V. (18%):"
                                   style="-fx-font-size: 12px;
                          -fx-text-fill: #6c757d;"/>
                            <Label fx:id="lblIgv" text="S/ 0.00"
                                   style="-fx-font-size: 12px;
                          -fx-text-fill: #1a1a2e;"
                                   prefWidth="120" alignment="CENTER_RIGHT"/>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="Total Dscto.:"
                                   style="-fx-font-size: 12px;
                          -fx-text-fill: #6c757d;"/>
                            <TextField fx:id="txtDescuento" text="0.00"
                                       prefWidth="120"
                                       style="-fx-font-size: 12px;
                              -fx-alignment: CENTER-RIGHT;"
                                       onKeyReleased="#actualizarTotal"/>
                        </HBox>

                        <Separator/>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="IMPORTE TOTAL:"
                                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1a1a2e;"/>
                            <Label fx:id="lblTotal" text="S/ 0.00"
                                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1a1a2e;"
                                   prefWidth="150" alignment="CENTER_RIGHT"/>
                        </HBox>

                        <Label fx:id="lblSubtotal" text=""
                               style="-fx-font-size: 10px;
                      -fx-text-fill: #aaaaaa;
                      -fx-font-style: italic;"/>
                    </VBox>

                    <!-- Pago y vuelto: solo visible si es Efectivo -->
                    <VBox fx:id="panelPagoEfectivo" spacing="5"
                          managed="false" visible="false">
                        <Separator/>
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="Monto pagado (S/):"
                                   style="-fx-font-size: 12px;
                          -fx-text-fill: #6c757d;"/>
                            <TextField fx:id="txtMontoPagado"
                                       promptText="0.00" prefWidth="120"
                                       style="-fx-font-size: 12px;
                              -fx-alignment: CENTER-RIGHT;"
                                       onKeyReleased="#calcularVuelto"/>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="Vuelto:"
                                   style="-fx-font-size: 12px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #495057;"/>
                            <Label fx:id="lblVuelto" text="S/ 0.00"
                                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #495057;"
                                   prefWidth="150" alignment="CENTER_RIGHT"/>
                        </HBox>
                    </VBox>

                    <Button text="💾 Registrar venta"
                            onAction="#registrarVenta"
                            maxWidth="Infinity"
                            style="-fx-background-color: #e94560;
                   -fx-text-fill: white;
                   -fx-background-radius: 8;
                   -fx-padding: 10 20;
                   -fx-cursor: hand;
                   -fx-font-weight: bold;
                   -fx-font-size: 14px;"/>
                </VBox>
            </HBox>
        </Tab>

        <!-- PESTAÑA 2: HISTORIAL DE VENTAS -->
        <Tab text="📋 Historial">
            <VBox spacing="12" style="-fx-padding: 16;">

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscarHistorial"
                               promptText="🔍 Buscar por N° comprobante o cliente..."
                               HBox.hgrow="ALWAYS"
                               onKeyReleased="#filtrarHistorial"/>
                </HBox>

                <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdVenta" text="ID" prefWidth="80"/>
                        <TableColumn fx:id="colComprobante" text="N° Comprobante" prefWidth="130"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="170"/>
                        <TableColumn fx:id="colEmpleado" text="Empleado" prefWidth="130"/>
                        <TableColumn fx:id="colMetodoPago" text="Método Pago" prefWidth="110"/>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120"/>
                        <TableColumn fx:id="colTotal" text="Total" prefWidth="90"/>
                        <TableColumn fx:id="colAccionesHist" text="Acciones" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.ProductoModalController"
      spacing="0"
      style="-fx-background-color: white;"
      prefWidth="460">

    <!-- CABECERA DINÁMICA
         Azul para VER, verde para EDITAR -->
    <VBox fx:id="panelCabecera" spacing="4" alignment="CENTER_LEFT"
          style="-fx-background-color: #4361ee; -fx-padding: 20 24;">

        <Label fx:id="lblTituloCabecera" text="DETALLE DE PRODUCTO"
               style="-fx-font-size: 11px; -fx-font-weight: bold;
                      -fx-text-fill: rgba(255,255,255,0.7);
                      -fx-letter-spacing: 1px;"/>

        <Label fx:id="lblNombreCabecera"
               style="-fx-font-size: 20px; -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <!-- Categoría como subtítulo -->
        <Label fx:id="lblCategoriaCabecera"
               style="-fx-font-size: 12px;
                      -fx-text-fill: rgba(255,255,255,0.75);"/>
    </VBox>

    <!-- CUERPO CON LOS CAMPOS -->
    <ScrollPane fitToWidth="true"
                style="-fx-background-color: white; -fx-background: white;
                       -fx-border-color: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="14" style="-fx-padding: 20;">

            <!-- SECCIÓN: Información general -->
            <Label text="📋 INFORMACIÓN GENERAL"
                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #4361ee; -fx-letter-spacing: 1px;"/>

            <VBox spacing="4">
                <Label text="ID Producto" styleClass="label-field"/>
                <TextField fx:id="txtId" disable="true"
                           style="-fx-background-color: #f0f0f0;
                          -fx-text-fill: #6c757d;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Nombre" styleClass="label-field"/>
                <TextField fx:id="txtNombre" promptText="Nombre del producto"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Descripción" styleClass="label-field"/>
                <TextArea fx:id="txtDescripcion"
                          promptText="Describe características, modelo, marca..."
                          prefRowCount="3" wrapText="true"/>
            </VBox>

            <Separator style="-fx-padding: 4 0;"/>

            <!-- SECCIÓN: Precios -->
            <Label text="💰 PRECIOS"
                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #2dc653; -fx-letter-spacing: 1px;"/>

            <HBox spacing="10">
                <!-- Precio compra: SOLO LECTURA, lo actualiza Compra (CPP) -->
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Precio Compra (CPP)" styleClass="label-field"/>
                    <TextField fx:id="txtPrecioCompra" disable="true"
                               style="-fx-background-color: #f0f0f0;
                              -fx-text-fill: #6c757d;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Precio Venta" styleClass="label-field"/>
                    <TextField fx:id="txtPrecioVenta" promptText="0.00"/>
                </VBox>
            </HBox>

            <Separator style="-fx-padding: 4 0;"/>

            <!-- SECCIÓN: Inventario -->
            <Label text="📦 INVENTARIO"
                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #f72585; -fx-letter-spacing: 1px;"/>

            <HBox spacing="10">
                <VBox spacing="4" prefWidth="80" minWidth="80" maxWidth="80">
                    <Label text="Stock actual" styleClass="label-field"/>
                    <TextField fx:id="txtStock" disable="true"
                               style="-fx-background-color: #f0f0f0;
                          -fx-text-fill: #6c757d;
                          -fx-alignment: CENTER;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Estado" styleClass="label-field"/>
                    <ComboBox fx:id="cbEstado" maxWidth="Infinity"
                              promptText="Selecciona"/>
                </VBox>
            </HBox>

            <!-- Stock mínimo y máximo en fila separada -->
            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Stock Mínimo" styleClass="label-field"/>
                    <TextField fx:id="txtStockMinimo" promptText="0"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Stock Máximo" styleClass="label-field"/>
                    <TextField fx:id="txtStockMaximo" promptText="0"/>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>

    <!-- PIE DEL MODAL -->
    <HBox spacing="10" alignment="CENTER_RIGHT"
          style="-fx-padding: 14 20;
                 -fx-background-color: #f8f9fa;
                 -fx-border-color: #e0e0e0 transparent transparent transparent;
                 -fx-border-width: 1;">

        <Button fx:id="btnCancelar" text="✖ Cerrar"
                onAction="#cancelar"
                style="-fx-background-color: #6c757d; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-cursor: hand;
                       -fx-padding: 8 16; -fx-font-size: 13px;"/>

        <Button fx:id="btnGuardar" text="💾 Guardar cambios"
                onAction="#guardar"
                style="-fx-background-color: #4361ee; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-cursor: hand;
                       -fx-padding: 8 16; -fx-font-size: 13px;
                       -fx-font-weight: bold;"/>
    </HBox>

</VBox>
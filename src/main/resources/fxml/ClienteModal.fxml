<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.ClienteModalController"
      spacing="0"
      style="-fx-background-color: white;"
      prefWidth="560">

    <!-- CABECERA: barra de marca + título chico / nombre grande -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-padding: 18 20; -fx-border-color: transparent transparent #E2E8F0 transparent; -fx-border-width: 1;">
        <Region prefWidth="4" minHeight="40"
                style="-fx-background-color: #E94560; -fx-background-radius: 2;"/>

        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTituloCabecera" text="DETALLE DE CLIENTE"
                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                          -fx-text-fill: #E94560; -fx-letter-spacing: 1px;"/>
            <Label fx:id="lblNombreCabecera" text="Nombre del cliente"
                   style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
            <Label fx:id="lblSubtituloCabecera"
                   style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
        </VBox>
    </HBox>

    <!-- CUERPO CON LOS CAMPOS, en 2 columnas.
         Sin ScrollPane: los campos de Cliente son pocos y siempre
         entran completos, un scroll aquí se vería fuera de lugar. -->
    <VBox spacing="16" style="-fx-padding: 22 24;">

        <Label text="DATOS PERSONALES"
               style="-fx-font-size: 12px; -fx-font-weight: bold;
              -fx-text-fill: #E94560; -fx-letter-spacing: 1px;"/>

        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="ID Cliente" styleClass="label-field"/>
                <TextField fx:id="txtId" disable="true" styleClass="campo-input"
                           maxWidth="Infinity" prefWidth="248"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Tipo de documento" styleClass="label-field"/>
                <ComboBox fx:id="cbTipoDocumento" maxWidth="Infinity" minWidth="0" prefWidth="248"
                          promptText="Selecciona tipo" onAction="#actualizarPlaceholder"/>
            </VBox>
        </HBox>

        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Nombre completo" styleClass="label-field"/>
                <TextField fx:id="txtNombre" styleClass="campo-input"
                           maxWidth="Infinity" prefWidth="248" promptText="Nombre completo"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Número de documento" styleClass="label-field"/>
                <TextField fx:id="txtNumeroDocumento" styleClass="campo-input"
                           maxWidth="Infinity" prefWidth="248" promptText="Selecciona un tipo primero"/>
            </VBox>
        </HBox>

        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Teléfono" styleClass="label-field"/>
                <TextField fx:id="txtTelefono" styleClass="campo-input"
                           maxWidth="Infinity" prefWidth="248" promptText="Ej: 987654321"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Correo electrónico" styleClass="label-field"/>
                <TextField fx:id="txtCorreo" styleClass="campo-input"
                           maxWidth="Infinity" prefWidth="248" promptText="correo@email.com"/>
            </VBox>
        </HBox>

        <VBox spacing="6">
            <Label text="Dirección" styleClass="label-field"/>
            <TextField fx:id="txtDireccion" styleClass="campo-input" promptText="Ej: Av. Lima 123"/>
        </VBox>

    </VBox>

    <!-- PIE DEL MODAL -->
    <HBox fx:id="panelBotones" spacing="10" alignment="CENTER_RIGHT"
          style="-fx-padding: 16 20;
                 -fx-background-color: #F8FAFC;
                 -fx-border-color: #E2E8F0 transparent transparent transparent;
                 -fx-border-width: 1;">

        <Button fx:id="btnCancelar" text="Cancelar"
                onAction="#cancelar"
                style="-fx-background-color: white; -fx-text-fill: #334155;
                       -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-padding: 9 18; -fx-font-size: 13px;"/>

        <Button fx:id="btnGuardar" text="Guardar" styleClass="btn-primary"
                onAction="#guardar"/>
    </HBox>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.ClienteModalController"
      spacing="0"
      style="-fx-background-color: white;"
      prefWidth="440">

    <!-- CABECERA DINÁMICA
         Azul en modo VER, verde en modo EDITAR
         fx:id para cambiar color y texto desde Java -->
    <VBox fx:id="panelCabecera" spacing="6" alignment="CENTER"
          style="-fx-background-color: #4361ee; -fx-padding: 24 20 18 20;">

        <!-- Ícono que cambia según el modo -->
        <Label fx:id="lblIconoCabecera" text="👤"
               style="-fx-font-size: 44px;"/>

        <!-- Nombre del cliente en la cabecera -->
        <Label fx:id="lblNombreCabecera"
               style="-fx-font-size: 18px; -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <!-- Tipo de documento como subtítulo -->
        <Label fx:id="lblSubtituloCabecera"
               style="-fx-font-size: 12px;
                      -fx-text-fill: rgba(255,255,255,0.8);"/>
    </VBox>

    <!-- CUERPO CON LOS CAMPOS
         ScrollPane para pantallas pequeñas -->
    <ScrollPane fitToWidth="true"
                style="-fx-background-color: white; -fx-background: white;
                       -fx-border-color: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="12" style="-fx-padding: 20;">

            <!-- ID: siempre deshabilitado -->
            <VBox spacing="4">
                <Label text="ID Cliente" styleClass="label-field"/>
                <TextField fx:id="txtId" disable="true"
                           style="-fx-background-color: #f0f0f0;
                                  -fx-text-fill: #6c757d;"/>
            </VBox>

            <!-- Nombre completo -->
            <VBox spacing="4">
                <Label text="Nombre completo" styleClass="label-field"/>
                <TextField fx:id="txtNombre" promptText="Nombre completo"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Tipo de documento" styleClass="label-field"/>
                <ComboBox fx:id="cbTipoDocumento" maxWidth="Infinity"
                          promptText="Selecciona tipo"
                          onAction="#actualizarPlaceholder"/>
            </VBox>

            <!-- Número de documento: su hint cambia según el tipo -->
            <VBox spacing="4">
                <Label text="Número de documento" styleClass="label-field"/>
                <TextField fx:id="txtNumeroDocumento"
                           promptText="Selecciona un tipo primero"/>
            </VBox>

            <!-- Teléfono -->
            <VBox spacing="4">
                <Label text="Teléfono" styleClass="label-field"/>
                <TextField fx:id="txtTelefono" promptText="Ej: 987654321"/>
            </VBox>

            <!-- Correo electrónico -->
            <VBox spacing="4">
                <Label text="Correo electrónico" styleClass="label-field"/>
                <TextField fx:id="txtCorreo" promptText="correo@email.com"/>
            </VBox>

            <!-- Dirección -->
            <VBox spacing="4">
                <Label text="Dirección" styleClass="label-field"/>
                <TextField fx:id="txtDireccion" promptText="Ej: Av. Lima 123"/>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- PIE DEL MODAL
         btnGuardar se oculta en modo VER
         btnCancelar cambia texto según el modo -->
    <HBox fx:id="panelBotones" spacing="10" alignment="CENTER_RIGHT"
          style="-fx-padding: 14 20;
                 -fx-background-color: #f8f9fa;
                 -fx-border-color: #e0e0e0 transparent transparent transparent;
                 -fx-border-width: 1;">

        <Button fx:id="btnCancelar" text="✖ Cerrar"
                onAction="#cancelar"
                style="-fx-background-color: #6c757d; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-cursor: hand;
                       -fx-padding: 8 16; -fx-font-size: 13px;"/>

        <Button fx:id="btnGuardar" text="💾 Guardar cambios"
                onAction="#guardar"
                style="-fx-background-color: #4361ee; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-cursor: hand;
                       -fx-padding: 8 16; -fx-font-size: 13px;
                       -fx-font-weight: bold;"/>
    </HBox>

</VBox>
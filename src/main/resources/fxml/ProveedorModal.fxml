<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.ProveedorModalController"
      spacing="0"
      style="-fx-background-color: white;"
      prefWidth="440">

    <!-- CABECERA DINÁMICA
         Azul para VER, verde para EDITAR -->
    <VBox fx:id="panelCabecera" spacing="4" alignment="CENTER_LEFT"
          style="-fx-background-color: #4361ee; -fx-padding: 20 24;">

        <Label fx:id="lblTituloCabecera" text="DETALLE DE PROVEEDOR"
               style="-fx-font-size: 11px; -fx-font-weight: bold;
                      -fx-text-fill: rgba(255,255,255,0.7);
                      -fx-letter-spacing: 1px;"/>

        <Label fx:id="lblNombreCabecera"
               style="-fx-font-size: 20px; -fx-font-weight: bold;
                      -fx-text-fill: white;"/>
    </VBox>

    <!-- CUERPO CON LOS CAMPOS -->
    <ScrollPane fitToWidth="true"
                style="-fx-background-color: white; -fx-background: white;
                       -fx-border-color: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="12" style="-fx-padding: 20;">

            <VBox spacing="4">
                <Label text="ID Proveedor" styleClass="label-field"/>
                <TextField fx:id="txtId" disable="true"
                           style="-fx-background-color: #f0f0f0;
                                  -fx-text-fill: #6c757d;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Nombre empresa" styleClass="label-field"/>
                <TextField fx:id="txtNombre"
                           promptText="Ej: Tech Solutions S.A.C."/>
            </VBox>

            <VBox spacing="4">
                <Label text="RUC" styleClass="label-field"/>
                <TextField fx:id="txtRuc"
                           promptText="11 dígitos numéricos"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Teléfono" styleClass="label-field"/>
                <TextField fx:id="txtTelefono"
                           promptText="Ej: 987654321"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Dirección" styleClass="label-field"/>
                <TextField fx:id="txtDireccion"
                           promptText="Ej: Av. Industrial 456"/>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- PIE DEL MODAL -->
    <HBox spacing="10" alignment="CENTER_RIGHT"
          style="-fx-padding: 14 20;
                 -fx-background-color: #f8f9fa;
                 -fx-border-color: #e0e0e0 transparent transparent transparent;
                 -fx-border-width: 1;">

        <Button fx:id="btnCancelar" text="✖ Cerrar"
                onAction="#cancelar"
                style="-fx-background-color: #6c757d; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-cursor: hand;
                       -fx-padding: 8 16; -fx-font-size: 13px;"/>

        <Button fx:id="btnGuardar" text="💾 Guardar cambios"
                onAction="#guardar"
                style="-fx-background-color: #4361ee; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-cursor: hand;
                       -fx-padding: 8 16; -fx-font-size: 13px;
                       -fx-font-weight: bold;"/>
    </HBox>

</VBox>

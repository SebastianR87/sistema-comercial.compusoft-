<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.CompraController"
      spacing="0" style="-fx-background-color: #f0f2f5;">

    <!-- TOPBAR -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>
        <Label text="📥 Compras" styleClass="topbar-title"/>
    </HBox>

    <!-- TABS: Nueva Compra e Historial -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS"
             tabClosingPolicy="UNAVAILABLE"
             style="-fx-background-color: #f0f2f5;">

        <Tab text="➕ Nueva Compra">
            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="16" bottom="16"
                            left="16" right="16"/>
                </padding>

                <!-- PANEL IZQUIERDO: datos + agregar producto -->
                <ScrollPane fitToWidth="true"
                            prefWidth="300" minWidth="300"
                            maxWidth="300"
                            style="-fx-background-color: transparent;
                   -fx-background: transparent;
                   -fx-border-color: transparent;">
                    <VBox spacing="14" style="-fx-padding: 0 4 0 0;">

                        <!-- Card datos de la compra -->
                        <VBox styleClass="card" spacing="10">
                            <Label text="📋 Datos de la compra"
                                   style="-fx-font-size: 13px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1a1a2e;"/>
                            <Separator/>

                            <VBox spacing="4">
                                <Label text="N° Comprobante"
                                       styleClass="label-field"/>
                                <TextField fx:id="txtNumeroComprobante"
                                           disable="true"
                                           style="-fx-background-color: #f0f0f0;"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Proveedor *" styleClass="label-field"/>
                                <ComboBox fx:id="cbProveedor"
                                          maxWidth="Infinity"
                                          promptText="Busca por nombre o RUC..."/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Empleado" styleClass="label-field"/>
                                <TextField fx:id="txtEmpleado"
                                           disable="true"
                                           style="-fx-background-color: #f0f0f0;"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Fecha" styleClass="label-field"/>
                                <TextField fx:id="txtFecha"
                                           disable="true"
                                           style="-fx-background-color: #f0f0f0;"/>
                            </VBox>
                        </VBox>

                        <!-- Card agregar producto -->
                        <VBox styleClass="card" spacing="10">
                            <Label text="🔍 Agregar producto"
                                   style="-fx-font-size: 13px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1a1a2e;"/>
                            <Separator/>

                            <VBox spacing="4">
                                <Label text="Buscar producto"
                                       styleClass="label-field"/>
                                <ComboBox fx:id="cbProducto"
                                          maxWidth="Infinity"
                                          promptText="Busca por nombre o ID..."/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Cantidad *" styleClass="label-field"/>
                                <TextField fx:id="txtCantidad"
                                           promptText="Ej: 10"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Precio unitario *"
                                       styleClass="label-field"/>
                                <TextField fx:id="txtPrecioUnitario"
                                           promptText="Ej: 150.00 o 150,50"/>
                            </VBox>

                            <!-- Botón siempre visible porque está dentro del scroll -->
                            <Button text="➕ Agregar al detalle"
                                    onAction="#agregarProducto"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #4361ee;
                           -fx-text-fill: white;
                           -fx-background-radius: 8;
                           -fx-padding: 8 16;
                           -fx-cursor: hand;
                           -fx-font-weight: bold;"/>
                        </VBox>

                    </VBox>
                </ScrollPane>

                <!-- PANEL DERECHO: tabla del detalle -->
                <VBox styleClass="card" spacing="12"
                      HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

                    <Label text="🛒 Detalle de la compra"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                  -fx-text-fill: #1a1a2e;"/>
                    <Separator/>

                    <TableView fx:id="tablaDetalle" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="Agrega productos al detalle"
                                   style="-fx-text-fill: #aaaaaa;
                          -fx-font-size: 13px;"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colProducto"
                                         text="Producto" prefWidth="200"/>
                            <TableColumn fx:id="colCantidad"
                                         text="Cantidad" prefWidth="80"/>
                            <TableColumn fx:id="colPrecioUnit"
                                         text="P. Unitario" prefWidth="100"/>
                            <TableColumn fx:id="colSubtotal"
                                         text="Subtotal" prefWidth="100"/>
                            <TableColumn fx:id="colQuitarDet"
                                         text="" prefWidth="60"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <Separator/>

                    <!-- Total y botón: NO tienen vgrow, siempre visibles -->
                    <HBox alignment="CENTER_RIGHT" spacing="20"
                          style="-fx-padding: 4 0 0 0;">
                        <VBox alignment="CENTER_RIGHT" spacing="3">
                            <Label text="Total de la compra"
                                   style="-fx-font-size: 12px;
                          -fx-text-fill: #6c757d;"/>
                            <Label fx:id="lblTotal" text="S/ 0.00"
                                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1a1a2e;"
                                   minWidth="160" alignment="CENTER_RIGHT"/>
                        </VBox>

                        <Button text="💾 Registrar compra"
                                onAction="#registrarCompra"
                                style="-fx-background-color: #e94560;
                       -fx-text-fill: white;
                       -fx-background-radius: 8;
                       -fx-padding: 10 20;
                       -fx-cursor: hand;
                       -fx-font-weight: bold;
                       -fx-font-size: 13px;"/>
                    </HBox>
                </VBox>
            </HBox>
        </Tab>

        <!-- ═══════════════════════════════════
             PESTAÑA 2: HISTORIAL DE COMPRAS
        ════════════════════════════════════ -->
        <Tab text="📋 Historial">
            <VBox spacing="12" style="-fx-padding: 16;">

                <!-- Buscador del historial -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscarHistorial"
                               promptText="🔍 Buscar por N° comprobante o proveedor..."
                               HBox.hgrow="ALWAYS"
                               onKeyReleased="#filtrarHistorial"/>
                </HBox>

                <!-- Tabla del historial -->
                <TableView fx:id="tablaHistorial"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdCompra"
                                     text="ID"
                                     prefWidth="90"/>
                        <TableColumn fx:id="colComprobante"
                                     text="N° Comprobante"
                                     prefWidth="140"/>
                        <TableColumn fx:id="colProveedor"
                                     text="Proveedor"
                                     prefWidth="180"/>
                        <TableColumn fx:id="colEmpleado"
                                     text="Empleado"
                                     prefWidth="140"/>
                        <TableColumn fx:id="colFecha"
                                     text="Fecha"
                                     prefWidth="130"/>
                        <TableColumn fx:id="colTotal"
                                     text="Total"
                                     prefWidth="100"/>
                        <TableColumn fx:id="colAccionesHist"
                                     text="Acciones"
                                     prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant=
                                           "CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
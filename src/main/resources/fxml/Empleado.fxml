<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.EmpleadoController"
      spacing="0" style="-fx-background-color: #f0f2f5;">

    <!-- TOPBAR -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>
        <Label text="👥 Empleados" styleClass="topbar-title"/>
    </HBox>

    <!-- CONTENIDO -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>

        <!-- FORMULARIO -->
        <VBox styleClass="card" spacing="16" prefWidth="280" minWidth="280">
            <Label text="Nuevo Empleado"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <Separator/>

            <VBox spacing="6">
                <Label text="ID" styleClass="label-field"/>
                <TextField fx:id="txtId" promptText="Ej: EMP001"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Nombre" styleClass="label-field"/>
                <TextField fx:id="txtNombre" promptText="Nombre completo"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Cargo" styleClass="label-field"/>
                <ComboBox fx:id="cbCargo" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <Label text="DNI" styleClass="label-field"/>
                <TextField fx:id="txtDni" promptText="Ej: 12345678"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Usuario" styleClass="label-field"/>
                <TextField fx:id="txtUsuario" promptText="Usuario para login"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Contraseña" styleClass="label-field"/>
                <HBox spacing="0">
                    <PasswordField fx:id="txtPassword" promptText="Contraseña"
                                   HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtPasswordVisible" promptText="Contraseña"
                               HBox.hgrow="ALWAYS" visible="false" managed="false"/>
                    <Button fx:id="btnMostrar" text="👁"
                            onAction="#togglePassword"
                            style="-fx-background-color: #f0f2f5;
                                   -fx-border-color: #e0e0e0;
                                   -fx-border-radius: 0 8 8 0;
                                   -fx-background-radius: 0 8 8 0;
                                   -fx-cursor: hand; -fx-font-size: 14px;
                                   -fx-padding: 8 10;"/>
                </HBox>
            </VBox>

            <VBox spacing="8">
                <Button text="💾 Guardar" styleClass="btn-primary"
                        onAction="#guardar" maxWidth="Infinity"/>
                <Button text="🔄 Limpiar" onAction="#limpiar"
                        maxWidth="Infinity"
                        style="-fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
            </VBox>
        </VBox>

        <!-- TABLA -->
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
            <Label text="Lista de Empleados"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <Separator/>

            <TableView fx:id="tablaEmpleado" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                    <TableColumn fx:id="colCargo" text="Cargo" prefWidth="120"/>
                    <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="100"/>
                    <TableColumn fx:id="colDni" text="DNI" prefWidth="100"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>

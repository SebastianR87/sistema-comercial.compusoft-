<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.EmpleadoController"
      spacing="0" style="-fx-background-color: #f0f2f5;">

    <!-- ToggleGroup definido aquí como hijo directo del VBox raíz
         porque no es un nodo visual. No puede estar dentro de un HBox.
         Se referencia desde los botones con toggleGroup="$toggleFiltro" -->
    <fx:define>
        <ToggleGroup fx:id="toggleFiltro"/>
    </fx:define>

    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>
        <Label text="👥 Empleados" styleClass="topbar-title"/>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>

        <!-- FORMULARIO NUEVO EMPLEADO -->
        <VBox styleClass="card" spacing="0"
              prefWidth="300" minWidth="300">

            <!-- Título fuera del scroll para que siempre sea visible -->
            <Label text="➕ Nuevo Empleado"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;
                  -fx-text-fill: #1a1a2e; -fx-padding: 0 0 10 0;"/>
            <Separator/>

            <!-- ScrollPane envuelve todos los campos para permitir scroll
                 fitToWidth="true" hace que los campos ocupen todo el ancho
                 style quita el borde y fondo gris que ScrollPane agrega por defecto -->
            <ScrollPane fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;
                       -fx-background: transparent;
                       -fx-border-color: transparent;
                       -fx-padding: 0;">

                <VBox spacing="12" style="-fx-padding: 10 4 10 4;">

                    <VBox spacing="5">
                        <Label text="ID" styleClass="label-field"/>
                        <TextField fx:id="txtId" promptText="Ej: EMP001"
                                   style="-fx-background-color: #f0f0f0;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Nombre completo" styleClass="label-field"/>
                        <TextField fx:id="txtNombre" promptText="Ej: Carlos Chapo"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Cargo" styleClass="label-field"/>
                        <ComboBox fx:id="cbCargo" maxWidth="Infinity"
                                  promptText="Selecciona un cargo"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Tipo de documento" styleClass="label-field"/>
                        <ComboBox fx:id="cbTipoDocumento" maxWidth="Infinity"
                                  promptText="Selecciona tipo"
                                  onAction="#actualizarPlaceholder"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Número de documento" styleClass="label-field"/>
                        <TextField fx:id="txtNumeroDocumento"
                                   promptText="Selecciona un tipo primero"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Teléfono" styleClass="label-field"/>
                        <TextField fx:id="txtTelefono" promptText="Ej: 987654321"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Dirección" styleClass="label-field"/>
                        <TextField fx:id="txtDireccion" promptText="Ej: Av. Lima 123"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Usuario" styleClass="label-field"/>
                        <TextField fx:id="txtUsuario" promptText="Usuario para login"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Contraseña" styleClass="label-field"/>
                        <HBox spacing="0">
                            <PasswordField fx:id="txtPassword" promptText="Contraseña"
                                           HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtPasswordVisible" promptText="Contraseña"
                                       HBox.hgrow="ALWAYS" visible="false" managed="false"/>
                            <Button fx:id="btnMostrar" text="👁"
                                    onAction="#togglePassword"
                                    style="-fx-background-color: #f0f2f5;
                                   -fx-border-color: #e0e0e0;
                                   -fx-border-radius: 0 8 8 0;
                                   -fx-background-radius: 0 8 8 0;
                                   -fx-cursor: hand; -fx-font-size: 14px;
                                   -fx-padding: 8 10;"/>
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- Botones fuera del scroll para que siempre estén visibles
                 sin necesidad de bajar hasta el final -->
            <Separator/>
            <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
                <Button text="💾 Guardar" styleClass="btn-primary"
                        onAction="#guardar" maxWidth="Infinity"/>
                <Button text="🔄 Limpiar" onAction="#limpiar"
                        maxWidth="Infinity"
                        style="-fx-background-color: #6c757d;
                       -fx-text-fill: white;
                       -fx-background-radius: 8;
                       -fx-padding: 8 16; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
        <!-- TABLA DE EMPLEADOS -->
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">

            <Label text="📋 Lista de Empleados"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;
                          -fx-text-fill: #1a1a2e;"/>
            <Separator/>

            <!-- BARRA DE HERRAMIENTAS: buscador + filtros -->
            <HBox spacing="10" alignment="CENTER_LEFT">

                <!-- onKeyReleased llama a filtrar() con cada tecla
                     para que el filtro sea en tiempo real -->
                <TextField fx:id="txtBuscar"
                           promptText="🔍  Buscar por nombre, DNI o usuario..."
                           HBox.hgrow="ALWAYS"
                           onKeyReleased="#filtrar"/>

                <!-- Los tres ToggleButtons referencian el ToggleGroup
                     definido arriba con el símbolo $ -->
                <ToggleButton fx:id="btnTodos" text="Todos"
                              toggleGroup="$toggleFiltro"
                              selected="true"
                              onAction="#filtrar"
                              style="-fx-background-color: #1a1a2e;
                                     -fx-text-fill: white;
                                     -fx-background-radius: 6;
                                     -fx-cursor: hand;
                                     -fx-font-size: 12px;
                                     -fx-padding: 6 12;"/>

                <ToggleButton fx:id="btnActivos" text="Activos"
                              toggleGroup="$toggleFiltro"
                              onAction="#filtrar"
                              style="-fx-background-radius: 6;
                                     -fx-cursor: hand;
                                     -fx-font-size: 12px;
                                     -fx-padding: 6 12;"/>

                <ToggleButton fx:id="btnInactivos" text="Inactivos"
                              toggleGroup="$toggleFiltro"
                              onAction="#filtrar"
                              style="-fx-background-radius: 6;
                                     -fx-cursor: hand;
                                     -fx-font-size: 12px;
                                     -fx-padding: 6 12;"/>
            </HBox>

            <TableView fx:id="tablaEmpleado" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"       text="ID"       prefWidth="70"/>
                    <TableColumn fx:id="colNombre"   text="Nombre"   prefWidth="150"/>
                    <TableColumn fx:id="colCargo"    text="Cargo"    prefWidth="110"/>
                    <TableColumn fx:id="colTipoDocumento"   text="Tipo Doc."     prefWidth="110"/>
                    <TableColumn fx:id="colNumeroDocumento" text="N° Documento" prefWidth="110"/>
                    <TableColumn fx:id="colEstado"   text="Estado"   prefWidth="80"/>
                    <!-- colAcciones tiene los 4 botones dinámicos -->
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="280"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.CotizacionController"
      spacing="0" style="-fx-background-color: #f0f2f5;">

    <!-- TOPBAR -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>
        <Label text="📝 Cotizaciones" styleClass="topbar-title"/>
    </HBox>

    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS"
             tabClosingPolicy="UNAVAILABLE"
             style="-fx-background-color: #f0f2f5;">

        <!-- PESTAÑA 1: NUEVA COTIZACIÓN -->
        <Tab text="➕ Nueva Cotización">
            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="16" bottom="16" left="16" right="16"/>
                </padding>

                <!-- PANEL IZQUIERDO -->
                <ScrollPane fitToWidth="true"
                            prefWidth="300" minWidth="300" maxWidth="300"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <VBox spacing="14">

                        <!-- Card datos -->
                        <VBox styleClass="card" spacing="10">
                            <Label text="📋 Datos de la cotización"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"/>
                            <Separator/>

                            <VBox spacing="4">
                                <Label text="N° Cotización" styleClass="label-field"/>
                                <TextField fx:id="txtNumeroCotizacion"
                                           disable="true"
                                           style="-fx-background-color: #f0f0f0;"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Cliente *" styleClass="label-field"/>
                                <ComboBox fx:id="cbCliente"
                                          maxWidth="Infinity"
                                          promptText="Busca por nombre o documento..."/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Empleado" styleClass="label-field"/>
                                <TextField fx:id="txtEmpleado"
                                           disable="true"
                                           style="-fx-background-color: #f0f0f0;"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Fecha" styleClass="label-field"/>
                                <TextField fx:id="txtFecha"
                                           disable="true"
                                           style="-fx-background-color: #f0f0f0;"/>
                            </VBox>
                        </VBox>

                        <!-- Card agregar producto -->
                        <VBox styleClass="card" spacing="10">
                            <Label text="🔍 Agregar producto"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"/>
                            <Separator/>

                            <VBox spacing="4">
                                <Label text="Producto" styleClass="label-field"/>
                                <ComboBox fx:id="cbProducto"
                                          maxWidth="Infinity"
                                          promptText="Busca por nombre o ID..."/>
                            </VBox>

                            <Label fx:id="lblStockDisponible" text=""
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #6c757d;
                                          -fx-font-style: italic;"/>

                            <VBox spacing="4">
                                <Label text="Cantidad *" styleClass="label-field"/>
                                <TextField fx:id="txtCantidad" promptText="Ej: 1"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Precio unitario (S/) *"
                                       styleClass="label-field"/>
                                <TextField fx:id="txtPrecioUnitario"
                                           promptText="0.00"/>
                            </VBox>

                            <Button text="➕ Agregar al detalle"
                                    onAction="#agregarProducto"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #4361ee;
               -fx-text-fill: white;
               -fx-background-radius: 8;
               -fx-padding: 8 16;
               -fx-cursor: hand;
               -fx-font-weight: bold;"/>

                            <!-- Verificador de compatibilidad del carrito -->
                            <Separator/>
                            <Button text="🔗 Verificar compatibilidad del carrito"
                                    onAction="#verificarCarrito"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #f8f9fa;
               -fx-text-fill: #4361ee;
               -fx-background-radius: 8;
               -fx-padding: 8 16;
               -fx-cursor: hand;
               -fx-border-color: #4361ee;
               -fx-border-radius: 8;
               -fx-border-width: 1;
               -fx-font-size: 12px;"/>

                            <!-- Panel resultado compatibilidad -->
                            <VBox fx:id="panelCompatibilidad" spacing="6"
                                  visible="false" managed="false"
                                  style="-fx-background-color: #f8f9fa;
             -fx-background-radius: 8;
             -fx-border-radius: 8;
             -fx-border-color: #e0e0e0;
             -fx-border-width: 1;
             -fx-padding: 10;">
                                <Label text="Resultados de compatibilidad:"
                                       style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #1a1a2e;"/>
                                <VBox fx:id="listaResultadosComp" spacing="4"/>
                            </VBox>
                        </VBox>  <!-- cierra card agregar producto -->
                    </VBox>      <!-- cierra VBox exterior del ScrollPane -->
                </ScrollPane>

                <!-- PANEL DERECHO -->
                <VBox styleClass="card" spacing="10"
                      HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

                    <Label text="🛒 Detalle de la cotización"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a2e;"/>
                    <Separator/>

                    <TableView fx:id="tablaDetalle" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCodigo"
                                         text="Código" prefWidth="90"/>
                            <TableColumn fx:id="colProducto"
                                         text="Producto" prefWidth="160"/>
                            <TableColumn fx:id="colCantidad"
                                         text="Cantidad" prefWidth="70"/>
                            <TableColumn fx:id="colPrecioUnit"
                                         text="P. Unitario" prefWidth="90"/>
                            <TableColumn fx:id="colSubtotal"
                                         text="Subtotal" prefWidth="90"/>
                            <TableColumn fx:id="colQuitarDet"
                                         text="" prefWidth="50"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <Separator/>

                    <!-- Resumen -->
                    <VBox spacing="5" style="-fx-padding: 4 0;">
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="Descuento (S/):"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #6c757d;"/>
                            <TextField fx:id="txtDescuento" text="0.00"
                                       prefWidth="120"
                                       style="-fx-font-size: 12px;
                                              -fx-alignment: CENTER-RIGHT;"
                                       onKeyReleased="#actualizarTotal"/>
                        </HBox>

                        <Separator/>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="TOTAL COTIZACIÓN:"
                                   style="-fx-font-size: 14px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"/>
                            <Label fx:id="lblTotal" text="S/ 0.00"
                                   style="-fx-font-size: 16px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"
                                   prefWidth="150" alignment="CENTER_RIGHT"/>
                        </HBox>

                        <Label fx:id="lblSubtotal" text=""
                               style="-fx-font-size: 10px;
                                      -fx-text-fill: #aaaaaa;
                                      -fx-font-style: italic;"/>
                    </VBox>

                    <Button text="💾 Guardar Cotización"
                            onAction="#registrarCotizacion"
                            maxWidth="Infinity"
                            style="-fx-background-color: #4361ee;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 8;
                                   -fx-padding: 10 20;
                                   -fx-cursor: hand;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 14px;"/>
                </VBox>
            </HBox>
        </Tab>

        <!-- PESTAÑA 2: HISTORIAL -->
        <Tab text="📋 Historial">
            <VBox spacing="12" style="-fx-padding: 16;">

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscarHistorial"
                               promptText="🔍 Buscar por N° o cliente..."
                               HBox.hgrow="ALWAYS"
                               onKeyReleased="#filtrarHistorial"/>

                    <!-- Filtro por estado -->
                    <ComboBox fx:id="cbFiltroEstado"
                              promptText="Todos los estados"
                              prefWidth="180"
                              onAction="#filtrarHistorial"/>
                </HBox>

                <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdCot"
                                     text="N° Cotización" prefWidth="120"/>
                        <TableColumn fx:id="colCliente"
                                     text="Cliente" prefWidth="170"/>
                        <TableColumn fx:id="colEmpleado"
                                     text="Empleado" prefWidth="130"/>
                        <TableColumn fx:id="colFecha"
                                     text="Fecha" prefWidth="130"/>
                        <TableColumn fx:id="colTotal"
                                     text="Total" prefWidth="90"/>
                        <TableColumn fx:id="colEstado"
                                     text="Estado" prefWidth="110"/>
                        <TableColumn fx:id="colAcciones"
                                     text="Acciones" prefWidth="200"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
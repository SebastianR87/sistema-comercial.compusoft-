<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.KardexController"
      spacing="0" style="-fx-background-color: #f0f2f5;">

    <!-- TOPBAR -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>
        <Label text="📊 Kárdex de Inventario" styleClass="topbar-title"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: #f0f2f5;
                       -fx-background: #f0f2f5;
                       -fx-border-color: transparent;">
        <VBox spacing="16" style="-fx-padding: 20;">

            <!-- SELECTOR DE PRODUCTO -->
            <VBox styleClass="card" spacing="12">
                <Label text="🔍 Selecciona un producto"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                  -fx-text-fill: #1a1a2e;"/>
                <Separator/>

                <!-- Contenedor principal con borde unificado
                     Todos los controles dentro tienen la misma altura
                     y comparten el mismo borde exterior como si fueran uno -->
                <HBox spacing="0" alignment="CENTER"
                      style="-fx-background-color: white;
                 -fx-border-color: #ced4da;
                 -fx-border-radius: 8;
                 -fx-background-radius: 8;
                 -fx-border-width: 1.5;
                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),6,0,0,2);">

                    <!-- Producto: separador derecho como divisor entre secciones -->
                    <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                          style="-fx-padding: 0 10;
                     -fx-border-color: transparent #ced4da transparent transparent;
                     -fx-border-width: 0 1 0 0;">
                        <Label text="📦"
                               style="-fx-font-size: 14px; -fx-padding: 0 6 0 0;"/>
                        <ComboBox fx:id="cbProducto"
                                  HBox.hgrow="ALWAYS"
                                  maxWidth="Infinity"
                                  promptText="Busca por nombre o ID del producto..."
                                  style="-fx-background-color: transparent;
                             -fx-border-color: transparent;
                             -fx-padding: 4 0;
                             -fx-font-size: 13px;"/>
                    </HBox>

                    <!-- Desde: con ícono de calendario -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 0 10;
                     -fx-border-color: transparent #ced4da transparent transparent;
                     -fx-border-width: 0 1 0 0;">
                        <Label text="Desde:"
                               style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #6c757d; -fx-padding: 0 6 0 0;"/>
                        <DatePicker fx:id="dpDesde"
                                    prefWidth="130"
                                    style="-fx-background-color: transparent;
                               -fx-border-color: transparent;
                               -fx-font-size: 12px;"/>
                    </HBox>

                    <!-- Hasta: con ícono de calendario -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 0 10;
                     -fx-border-color: transparent #ced4da transparent transparent;
                     -fx-border-width: 0 1 0 0;">
                        <Label text="Hasta:"
                               style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #6c757d; -fx-padding: 0 6 0 0;"/>
                        <DatePicker fx:id="dpHasta"
                                    prefWidth="130"
                                    style="-fx-background-color: transparent;
                               -fx-border-color: transparent;
                               -fx-font-size: 12px;"/>
                    </HBox>

                    <!-- Botones dentro del mismo contenedor -->
                    <HBox spacing="0" alignment="CENTER">

                        <!-- Generar: azul -->
                        <Button text="🔍 Generar"
                                onAction="#generarKardex"
                                prefHeight="42" prefWidth="110"
                                style="-fx-background-color: #4361ee;
                   -fx-text-fill: white;
                   -fx-background-radius: 0;
                   -fx-cursor: hand;
                   -fx-font-weight: bold;
                   -fx-font-size: 12px;
                   -fx-border-color: transparent #2d4bc4 transparent transparent;
                   -fx-border-width: 0 1 0 0;"/>

                        <!-- Limpiar: gris -->
                        <Button text="🔄 Limpiar"
                                onAction="#limpiar"
                                prefHeight="42" prefWidth="110"
                                style="-fx-background-color: #6c757d;
                   -fx-text-fill: white;
                   -fx-background-radius: 0;
                   -fx-cursor: hand;
                   -fx-font-size: 12px;
                   -fx-border-color: transparent #545b62 transparent transparent;
                   -fx-border-width: 0 1 0 0;"/>

                        <!-- Imprimir: verde, solo visible cuando hay datos -->
                        <Button fx:id="btnImprimir"
                                text="🖨 Imprimir"
                                onAction="#imprimirKardex"
                                prefHeight="42" prefWidth="110"
                                visible="false" managed="false"
                                style="-fx-background-color: #2dc653;
                   -fx-text-fill: white;
                   -fx-background-radius: 0 8 8 0;
                   -fx-cursor: hand;
                   -fx-font-size: 12px;"/>
                    </HBox>
                </HBox>

                <!-- Nota informativa debajo del buscador -->
                <Label text="💡 Selecciona un producto y un rango de fechas, luego presiona Generar."
                       style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;
                  -fx-font-style: italic;"/>
            </VBox>

            <!-- FICHA DEL PRODUCTO -->
            <VBox fx:id="panelFicha" spacing="0"
                  visible="false" managed="false"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),10,0,0,2);
                         -fx-border-color: #e0e0e0;
                         -fx-border-radius: 12;
                         -fx-border-width: 1;">

                <!-- Cabecera de la ficha con fondo oscuro, tipo boleta -->
                <VBox spacing="4"
                      style="-fx-background-color: #1a1a2e;
                             -fx-background-radius: 12 12 0 0;
                             -fx-padding: 16 20;">
                    <Label text="FICHA DEL PRODUCTO"
                           style="-fx-font-size: 10px; -fx-font-weight: bold;
                                  -fx-text-fill: rgba(255,255,255,0.6);
                                  -fx-letter-spacing: 1px;"/>
                    <Label fx:id="lblProducto"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                    <Label fx:id="lblCategoria"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: rgba(255,255,255,0.7);"/>
                </VBox>

                <!-- Métricas en tarjetas horizontales -->
                <HBox spacing="0">
                    <!-- Existencia Actual -->
                    <VBox spacing="4" alignment="CENTER"
                          HBox.hgrow="ALWAYS"
                          prefWidth="160" minWidth="120"
                          style="-fx-padding: 20 12;
             -fx-border-color: transparent #e0e0e0 transparent transparent;
             -fx-border-width: 0 1 0 0;">
                        <Label text="Existencia Actual"
                               style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #6c757d; -fx-letter-spacing: 0.5px;"/>
                        <Label fx:id="lblExistenciaActual"
                               style="-fx-font-size: 24px; -fx-font-weight: bold;
              -fx-text-fill: #4361ee;
              -fx-min-width: 60px;"/>
                        <Label text="unidades"
                               style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;"/>
                    </VBox>

                    <!-- Stock Mínimo -->
                    <VBox spacing="4" alignment="CENTER"
                          HBox.hgrow="ALWAYS"
                          prefWidth="160" minWidth="120"
                          style="-fx-padding: 20 12;
             -fx-border-color: transparent #e0e0e0 transparent transparent;
             -fx-border-width: 0 1 0 0;">
                        <Label text="Stock Mínimo"
                               style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #6c757d; -fx-letter-spacing: 0.5px;"/>
                        <Label fx:id="lblStockMinimo"
                               style="-fx-font-size: 24px; -fx-font-weight: bold;
              -fx-text-fill: #e67e00;
              -fx-min-width: 60px;"/>
                        <Label text="unidades"
                               style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;"/>
                    </VBox>

                    <!-- Stock Máximo: sin borde derecho porque es el último -->
                    <VBox spacing="4" alignment="CENTER"
                          HBox.hgrow="ALWAYS"
                          prefWidth="160" minWidth="120"
                          style="-fx-padding: 20 12;">
                        <Label text="Stock Máximo"
                               style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #6c757d; -fx-letter-spacing: 0.5px;"/>
                        <Label fx:id="lblStockMaximo"
                               style="-fx-font-size: 24px; -fx-font-weight: bold;
              -fx-text-fill: #2dc653;
              -fx-min-width: 60px;"/>
                        <Label text="unidades"
                               style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- TABLA KÁRDEX -->
            <VBox fx:id="panelTabla" styleClass="card" spacing="12"
                  VBox.vgrow="ALWAYS" visible="false" managed="false">

                <Label text="📊 Movimientos de Inventario"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                              -fx-text-fill: #1a1a2e;"/>
                <Separator/>

                <TableView fx:id="tablaKardex" VBox.vgrow="ALWAYS"
                           minHeight="200"
                           style="-fx-background-color: white;
                                  -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 8;
                                  -fx-background-radius: 8;">
                    <columns>
                        <TableColumn fx:id="colFecha"
                                     text="Fecha" prefWidth="120"/>
                        <TableColumn fx:id="colDetalle"
                                     text="Detalle" prefWidth="130"/>

                        <TableColumn text="📥 Entradas"
                                     style="-fx-alignment: CENTER;
                                            -fx-background-color: #eef8f0;">
                            <columns>
                                <TableColumn fx:id="colEntradaCant"
                                             text="Cantidad" prefWidth="70"/>
                                <TableColumn fx:id="colEntradaCosto"
                                             text="C. Unitario" prefWidth="90"/>
                                <TableColumn fx:id="colEntradaTotal"
                                             text="Total" prefWidth="90"/>
                            </columns>
                        </TableColumn>

                        <TableColumn text="📤 Salidas"
                                     style="-fx-alignment: CENTER;
                                            -fx-background-color: #fef0f0;">
                            <columns>
                                <TableColumn fx:id="colSalidaCant"
                                             text="Cantidad" prefWidth="70"/>
                                <TableColumn fx:id="colSalidaCosto"
                                             text="C. Unitario" prefWidth="90"/>
                                <TableColumn fx:id="colSalidaTotal"
                                             text="Total" prefWidth="90"/>
                            </columns>
                        </TableColumn>

                        <TableColumn text="📦 Existencias"
                                     style="-fx-alignment: CENTER;
                                            -fx-background-color: #eef2ff;">
                            <columns>
                                <TableColumn fx:id="colSaldoCant"
                                             text="Cantidad" prefWidth="70"/>
                                <TableColumn fx:id="colSaldoCosto"
                                             text="C. Unitario" prefWidth="90"/>
                                <TableColumn fx:id="colSaldoTotal"
                                             text="Total" prefWidth="90"/>
                            </columns>
                        </TableColumn>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <!-- Totales: 3 cards de resumen al pie -->
                <HBox spacing="10">
                    <VBox spacing="4" alignment="CENTER"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #eef8f0;
                                 -fx-background-radius: 8;
                                 -fx-padding: 10 16;
                                 -fx-border-color: #c3e6cb;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;">
                        <Label text="TOTAL ENTRADAS"
                               style="-fx-font-size: 10px; -fx-font-weight: bold;
                                      -fx-text-fill: #2dc653;"/>
                        <Label fx:id="lblTotalEntradas"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;
                                      -fx-text-fill: #2dc653;"/>
                    </VBox>
                    <VBox spacing="4" alignment="CENTER"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #fef0f0;
                                 -fx-background-radius: 8;
                                 -fx-padding: 10 16;
                                 -fx-border-color: #f5c6cb;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;">
                        <Label text="TOTAL SALIDAS"
                               style="-fx-font-size: 10px; -fx-font-weight: bold;
                                      -fx-text-fill: #e94560;"/>
                        <Label fx:id="lblTotalSalidas"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;
                                      -fx-text-fill: #e94560;"/>
                    </VBox>
                    <VBox spacing="4" alignment="CENTER"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #eef2ff;
                                 -fx-background-radius: 8;
                                 -fx-padding: 10 16;
                                 -fx-border-color: #c5cff7;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;">
                        <Label text="SALDO ACTUAL"
                               style="-fx-font-size: 10px; -fx-font-weight: bold;
                                      -fx-text-fill: #4361ee;"/>
                        <Label fx:id="lblSaldoActual"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;
                                      -fx-text-fill: #4361ee;"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
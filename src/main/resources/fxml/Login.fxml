<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!-- prefWidth y prefHeight ajustados para que coincidan
     exactamente con el contenido sin espacio sobrante -->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="pe.utp.controller.LoginController"
           stylesheets="@../styles/style.css"
           style="-fx-background-color: #1a1a2e;"
           prefWidth="700" prefHeight="520">

    <HBox alignment="CENTER" spacing="0">

        <!-- PANEL IZQUIERDO: identidad visual -->
        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: #e94560;
                     -fx-padding: 50 40;
                     -fx-background-radius: 12 0 0 12;"
              prefWidth="360" prefHeight="480">

            <Label text="🖥️"
                   style="-fx-font-size: 56px;"/>

            <Label text="COMPUSOFT"
                   style="-fx-text-fill: white; -fx-font-size: 26px;
                          -fx-font-weight: bold; -fx-letter-spacing: 2px;"/>

            <Label text="Sistema Comercial"
                   style="-fx-text-fill: rgba(255,255,255,0.8);
                          -fx-font-size: 13px;"/>

            <Separator style="-fx-background-color: rgba(255,255,255,0.3);
                              -fx-padding: 0 20;"/>

            <Label text="Gestiona tu negocio de&#10;componentes de PC"
                   style="-fx-text-fill: rgba(255,255,255,0.85);
                          -fx-font-size: 13px; -fx-text-alignment: center;"
                   textAlignment="CENTER"/>
        </VBox>

        <!-- PANEL DERECHO: formulario -->
        <VBox alignment="CENTER" spacing="18"
              style="-fx-background-color: white;
                     -fx-padding: 50 40;
                     -fx-background-radius: 0 12 12 0;"
              prefWidth="360" prefHeight="480">

            <Label text="Iniciar Sesión"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;
                          -fx-text-fill: #1a1a2e;"/>

            <Label text="Ingresa tus credenciales"
                   style="-fx-font-size: 12px; -fx-text-fill: #aaaaaa;"/>

            <VBox spacing="6">
                <Label text="Usuario" styleClass="label-field"/>
                <TextField fx:id="txtUsuario"
                           promptText="Ingresa tu usuario"
                           prefWidth="260"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Contraseña" styleClass="label-field"/>
                <PasswordField fx:id="txtPassword"
                               promptText="Ingresa tu contraseña"
                               prefWidth="260"/>
            </VBox>

            <!-- Label de error oculto hasta que haya un error -->
            <Label fx:id="lblError"
                   style="-fx-text-fill: #e94560; -fx-font-size: 12px;"
                   text="" visible="false"/>

            <Button text="Iniciar Sesión"
                    styleClass="btn-primary"
                    onAction="#login"
                    prefWidth="260"/>
        </VBox>

    </HBox>
</StackPane>
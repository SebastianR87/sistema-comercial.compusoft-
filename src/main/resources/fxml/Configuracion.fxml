<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.ConfiguracionController"
      spacing="0" style="-fx-background-color: #f0f2f5;">

    <!-- TOPBAR -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>
        <Label text="Configuración" styleClass="topbar-title"/>
    </HBox>

    <!-- PESTAÑAS -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS"
             style="-fx-padding: 20; -fx-background-color: #f0f2f5;">

        <!-- PESTAÑA TIPO DOCUMENTO -->
        <Tab text="📄 Tipo Documento" closable="false">
            <HBox spacing="20" style="-fx-padding: 20;">

                <VBox styleClass="card" spacing="14" prefWidth="280">
                    <Label fx:id="lblTituloTipoDoc" text="➕ Nuevo Tipo Documento"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Separator/>
                    <VBox spacing="6">
                        <Label text="ID" styleClass="label-field"/>
                        <TextField fx:id="txtIdTipoDoc" promptText="Ej: TD001"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Documento" styleClass="label-field"/>
                        <TextField fx:id="txtDocumento" promptText="Ej: DNI"/>
                    </VBox>
                    <VBox spacing="8">
                        <Button text="💾 Guardar" styleClass="btn-primary"
                                onAction="#guardarTipoDoc" maxWidth="Infinity"/>
                        <Button text="🔄 Limpiar" onAction="#limpiarTipoDoc"
                                maxWidth="Infinity"
                                style="-fx-background-radius: 8; -fx-padding: 8 16;
                                       -fx-cursor: hand;"/>
                    </VBox>
                </VBox>

                <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                    <Label text="Lista de Tipos de Documento"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a2e;"/>
                    <Separator/>
                    <TableView fx:id="tablaTipoDoc" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colIdTipoDoc" text="ID" prefWidth="100"/>
                            <TableColumn fx:id="colDocumento" text="Documento" prefWidth="200"/>
                            <TableColumn fx:id="colAccTipoDoc" text="Acciones" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </HBox>
        </Tab>

        <!-- PESTAÑA TIPO COMPROBANTE -->
        <Tab text="📄 Tipo Comprobante" closable="false">
            <HBox spacing="20" style="-fx-padding: 20;">

                <VBox styleClass="card" spacing="14" prefWidth="280">
                    <Label fx:id="lblTituloTipoComp" text="➕ Nuevo Tipo Comprobante"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Separator/>
                    <VBox spacing="6">
                        <Label text="ID" styleClass="label-field"/>
                        <TextField fx:id="txtIdTipoComp" promptText="Ej: TC001"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Nombre" styleClass="label-field"/>
                        <TextField fx:id="txtNombreComp" promptText="Ej: Boleta"/>
                    </VBox>
                    <VBox spacing="8">
                        <Button text="💾 Guardar" styleClass="btn-primary"
                                onAction="#guardarTipoComp" maxWidth="Infinity"/>
                        <Button text="🔄 Limpiar" onAction="#limpiarTipoComp"
                                maxWidth="Infinity"
                                style="-fx-background-radius: 8; -fx-padding: 8 16;
                                       -fx-cursor: hand;"/>
                    </VBox>
                </VBox>

                <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                    <Label text="Lista de Tipos de Comprobante"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a2e;"/>
                    <Separator/>
                    <TableView fx:id="tablaTipoComp" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colIdTipoComp" text="ID" prefWidth="100"/>
                            <TableColumn fx:id="colNombreComp" text="Nombre" prefWidth="200"/>
                            <TableColumn fx:id="colAccTipoComp" text="Acciones" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </HBox>
        </Tab>

        <!-- PESTAÑA METODO PAGO -->
        <Tab text="💳 Método Pago" closable="false">
            <HBox spacing="20" style="-fx-padding: 20;">

                <VBox styleClass="card" spacing="14" prefWidth="280">
                    <Label fx:id="lblTituloMetodoPago" text="➕ Nuevo Método de Pago"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Separator/>
                    <VBox spacing="6">
                        <Label text="ID" styleClass="label-field"/>
                        <TextField fx:id="txtIdMetodoPago" promptText="Ej: MP001"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Método de Pago" styleClass="label-field"/>
                        <TextField fx:id="txtMetodoPago" promptText="Ej: Efectivo"/>
                    </VBox>
                    <VBox spacing="8">
                        <Button text="💾 Guardar" styleClass="btn-primary"
                                onAction="#guardarMetodoPago" maxWidth="Infinity"/>
                        <Button text="🔄 Limpiar" onAction="#limpiarMetodoPago"
                                maxWidth="Infinity"
                                style="-fx-background-radius: 8; -fx-padding: 8 16;
                                       -fx-cursor: hand;"/>
                    </VBox>
                </VBox>

                <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                    <Label text="Lista de Métodos de Pago"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a2e;"/>
                    <Separator/>
                    <TableView fx:id="tablaMetodoPago" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colIdMetodoPago" text="ID" prefWidth="100"/>
                            <TableColumn fx:id="colMetodoPago" text="Método" prefWidth="200"/>
                            <TableColumn fx:id="colAccMetodoPago" text="Acciones" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </HBox>
        </Tab>

    </TabPane>
</VBox>
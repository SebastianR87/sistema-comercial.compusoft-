<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.ClienteController"
      spacing="0" style="-fx-background-color: #f0f2f5;">

    <!-- TOPBAR -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>
        <Label text="👤 Clientes" styleClass="topbar-title"/>
    </HBox>

    <!-- CONTENIDO -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>

        <!-- FORMULARIO -->
        <VBox styleClass="card" spacing="14" prefWidth="300" minWidth="300">
            <Label text="Nuevo Cliente"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;
                          -fx-text-fill: #1a1a2e;"/>
            <Separator/>

            <VBox spacing="6">
                <Label text="ID" styleClass="label-field"/>
                <TextField fx:id="txtId" promptText="Ej: CLI001"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Nombre" styleClass="label-field"/>
                <TextField fx:id="txtNombre" promptText="Nombre completo"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Tipo Documento" styleClass="label-field"/>
                <ComboBox fx:id="cbTipoDocumento" maxWidth="Infinity"
                          promptText="Selecciona tipo"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Número Documento" styleClass="label-field"/>
                <TextField fx:id="txtNumeroDocumento" promptText="Ej: 12345678"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Teléfono" styleClass="label-field"/>
                <TextField fx:id="txtTelefono" promptText="Ej: 999999999"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Correo" styleClass="label-field"/>
                <TextField fx:id="txtCorreo" promptText="correo@email.com"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Dirección" styleClass="label-field"/>
                <TextField fx:id="txtDireccion" promptText="Dirección"/>
            </VBox>

            <VBox spacing="8">
                <Button text="💾 Guardar" styleClass="btn-primary"
                        onAction="#guardar" maxWidth="Infinity"/>
                <Button text="🔄 Limpiar" onAction="#limpiar"
                        maxWidth="Infinity"
                        style="-fx-background-radius: 8; -fx-padding: 8 16;
                               -fx-cursor: hand;"/>
            </VBox>
        </VBox>

        <!-- TABLA -->
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">

            <!-- BUSCADOR -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Lista de Clientes"
                       style="-fx-font-size: 15px; -fx-font-weight: bold;
                              -fx-text-fill: #1a1a2e;"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtBuscar" promptText="🔍 Buscar cliente..."
                           prefWidth="200"
                           onKeyReleased="#buscar"/>
            </HBox>

            <Separator/>

            <TableView fx:id="tablaCliente" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                    <TableColumn fx:id="colTipoDoc" text="Tipo Doc" prefWidth="80"/>
                    <TableColumn fx:id="colNumDoc" text="Nro Doc" prefWidth="100"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="100"/>
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="150"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>
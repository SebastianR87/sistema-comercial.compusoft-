<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.ProductoController"
      spacing="0" style="-fx-background-color: #f0f2f5;">

    <!-- TOPBAR -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>
        <Label text="🖥️ Productos" styleClass="topbar-title"/>
        <Label fx:id="lblModoConsulta" text="Solo consulta"
               visible="false" managed="false"
               style="-fx-text-fill: #6c757d; -fx-font-size: 12px;
                      -fx-font-style: italic;"/>
    </HBox>

    <!-- CARDS DE CATEGORIAS
         Solo visibles cuando panelContenido está oculto -->
    <VBox fx:id="panelCards_contenedor" spacing="8"
          VBox.vgrow="ALWAYS"
          style="-fx-padding: 16 20 16 20;">
        <Label text="Selecciona una categoría"
               style="-fx-font-size: 13px; -fx-text-fill: #6c757d;
                  -fx-font-weight: bold;"/>

        <!-- Sin altura fija, crece con la ventana -->
        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent;
                       -fx-background: transparent;
                       -fx-border-color: transparent;
                       -fx-padding: 0;">
            <FlowPane fx:id="panelCards" hgap="12" vgap="12"
                      style="-fx-padding: 8;"/>
        </ScrollPane>
    </VBox>

    <!-- BREADCRUMB: aparece cuando hay una categoría seleccionada
     Reemplaza visualmente a las cards para liberar espacio -->
    <HBox fx:id="panelBreadcrumb" spacing="8" alignment="CENTER_LEFT"
          visible="false" managed="false"
          style="-fx-padding: 12 20 0 20;">
        <Button text="← Categorías" onAction="#volverCards"
                style="-fx-background-color: #e9ecef;
                   -fx-text-fill: #495057;
                   -fx-background-radius: 8;
                   -fx-padding: 6 14;
                   -fx-cursor: hand;
                   -fx-font-size: 12px;
                   -fx-font-weight: bold;"/>
        <Label text="／" style="-fx-text-fill: #ced4da; -fx-font-size: 14px;"/>
        <Label fx:id="lblBreadcrumbCategoria"
               style="-fx-text-fill: #1a1a2e; -fx-font-size: 14px;
                  -fx-font-weight: bold;"/>
    </HBox>

    <!-- CONTENIDO: formulario + tabla
         Aparece al hacer clic en una card -->
    <HBox fx:id="panelContenido" spacing="16"
          VBox.vgrow="ALWAYS"
          visible="false" managed="false">
        <padding>
            <Insets top="12" bottom="16" left="16" right="16"/>
        </padding>

        <!-- FORMULARIO NUEVO PRODUCTO con scroll -->
        <ScrollPane fx:id="panelFormulario"
                    fitToWidth="true"
                    prefWidth="300" minWidth="300" maxWidth="300"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox styleClass="card" spacing="14">

                <Label fx:id="lblTituloFormulario"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;-fx-text-fill: #1a1a2e;"/>

                <Separator/>

                <!-- SECCIÓN: Información general -->
                <Label text="📋 INFORMACIÓN GENERAL"
                       style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #4361ee; -fx-letter-spacing: 1px;"/>

                <VBox spacing="5">
                    <Label text="ID" styleClass="label-field"/>
                    <TextField fx:id="txtId"
                               style="-fx-background-color: #f0f0f0;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Nombre" styleClass="label-field"/>
                    <TextField fx:id="txtNombre"
                               promptText="Nombre del producto"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Descripción" styleClass="label-field"/>
                    <TextArea fx:id="txtDescripcion"
                              promptText="Describe características, modelo, marca..."
                              prefRowCount="3" wrapText="true"/>
                </VBox>

                <Separator style="-fx-padding: 4 0;"/>

                <!-- SECCIÓN: Precio -->
                <Label text="💰 PRECIO"
                       style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #2dc653; -fx-letter-spacing: 1px;"/>

                <VBox spacing="5">
                    <Label text="Precio Venta (S/)" styleClass="label-field"/>
                    <TextField fx:id="txtPrecioVenta" promptText="0.00"/>
                </VBox>

                <!-- Aviso informativo con fondo destacado -->
                <HBox spacing="6" alignment="TOP_LEFT"
                      style="-fx-background-color: #eef2ff;
                 -fx-background-radius: 8;
                 -fx-padding: 8 10;">
                    <Label text="ℹ️" style="-fx-font-size: 13px;"/>
                    <Label text="El precio de compra se definirá automáticamente al registrar la primera compra de este producto."
                           wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 11px; -fx-text-fill: #4361ee;"/>
                </HBox>

                <Separator style="-fx-padding: 4 0;"/>

                <!-- SECCIÓN: Stock y estado -->
                <Label text="📦 INVENTARIO"
                       style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #f72585; -fx-letter-spacing: 1px;"/>

                <HBox spacing="10">
                    <!-- Stock inicial: ancho fijo y pequeño, solo muestra "0" -->
                    <VBox spacing="5" prefWidth="80" minWidth="80" maxWidth="80">
                        <Label text="Stock" styleClass="label-field"/>
                        <TextField fx:id="txtStock" text="0" disable="true"
                                   style="-fx-background-color: #f0f0f0;
                      -fx-alignment: CENTER;"/>
                    </VBox>
                    <!-- Estado: toma el resto del espacio disponible -->
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Estado" styleClass="label-field"/>
                        <ComboBox fx:id="cbEstado" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Stock mínimo y máximo: definidos por Administrador/Almacenero
                     desde el registro, sirven como referencia para alertas de Kardex -->
                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Stock Mínimo" styleClass="label-field"/>
                        <TextField fx:id="txtStockMinimo" promptText="0"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Stock Máximo" styleClass="label-field"/>
                        <TextField fx:id="txtStockMaximo" promptText="0"/>
                    </VBox>
                </HBox>

                <Separator style="-fx-padding: 4 0;"/>

                <Button text="💾 Guardar" styleClass="btn-primary"
                        onAction="#guardar" maxWidth="Infinity"/>
                <Button text="🔄 Limpiar" onAction="#limpiar"
                        maxWidth="Infinity"
                        style="-fx-background-radius: 8;
                   -fx-padding: 8 16; -fx-cursor: hand;"/>
            </VBox>
        </ScrollPane>

        <!-- TABLA DE PRODUCTOS -->
        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblTituloTabla"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;
                      -fx-text-fill: #1a1a2e;"
                       HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblContadorProductos"
                       style="-fx-font-size: 12px; -fx-text-fill: #6c757d;"/>
            </HBox>

            <!-- Buscador minimalista igual que en Categoría -->
            <HBox spacing="0" alignment="CENTER_LEFT"
                  style="-fx-background-color: #f8f9fa;
                 -fx-border-color: #e0e0e0;
                 -fx-border-radius: 8;
                 -fx-background-radius: 8;
                 -fx-border-width: 1;
                 -fx-padding: 0 10;">
                <Label text="🔍"
                       style="-fx-font-size: 13px; -fx-text-fill: #aaaaaa;
                      -fx-padding: 0 6 0 0;"/>
                <TextField fx:id="txtBuscarProducto"
                           promptText="Buscar por nombre o código..."
                           HBox.hgrow="ALWAYS"
                           onKeyReleased="#filtrarProductos"
                           style="-fx-background-color: transparent;
                          -fx-border-color: transparent;
                          -fx-font-size: 13px;
                          -fx-padding: 7 0;"/>
            </HBox>

            <Separator/>

            <TableView fx:id="tablaProducto" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"
                                 text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colNombre"
                                 text="Nombre" prefWidth="160"/>
                    <TableColumn fx:id="colPrecioCompra"
                                 text="P. Compra" prefWidth="90"/>
                    <TableColumn fx:id="colPrecioVenta"
                                 text="P. Venta" prefWidth="90"/>
                    <TableColumn fx:id="colStock"
                                 text="Stock" prefWidth="60"/>
                    <TableColumn fx:id="colEstado"
                                 text="Estado" prefWidth="80"/>
                    <TableColumn fx:id="colAcciones"
                                 text="Acciones"  prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>
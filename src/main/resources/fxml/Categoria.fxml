<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.CategoriaController"
      spacing="0" style="-fx-background-color: #f0f2f5;">

    <!-- TOPBAR -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>
        <Label text="📦 Categorías" styleClass="topbar-title"/>
        <Label fx:id="lblModoConsulta" text="Solo consulta"
               visible="false" managed="false"
               style="-fx-text-fill: #6c757d; -fx-font-size: 12px;
                      -fx-font-style: italic;"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS">
        <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>

        <!-- Antes había un panel fijo a la izquierda para "Nueva
             Categoría" y Editar reusaba esos mismos campos, sin
             distinguir visualmente ambos modos. Ahora Crear y Editar
             abren el mismo modal (CategoriaModal.fxml), igual que en
             Proveedor/Cliente/Empleado/Producto, y esta pantalla queda
             solo con la búsqueda y la tabla. -->
        <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Lista de Categorías"
                       style="-fx-font-size: 15px; -fx-font-weight: bold;
                      -fx-text-fill: #1a1a2e;"
                       HBox.hgrow="ALWAYS"/>
                <!-- Contador dinámico -->
                <Label fx:id="lblContador"
                       style="-fx-font-size: 12px; -fx-text-fill: #6c757d;"/>
            </HBox>

            <!-- Buscador a la izquierda, botón de crear a la derecha -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <HBox spacing="0" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #f8f9fa;
                     -fx-border-color: #e0e0e0;
                     -fx-border-radius: 8;
                     -fx-background-radius: 8;
                     -fx-border-width: 1;
                     -fx-padding: 0 10;">
                    <Label text="🔍"
                           style="-fx-font-size: 13px; -fx-text-fill: #aaaaaa;
                          -fx-padding: 0 6 0 0;"/>
                    <TextField fx:id="txtBuscar"
                               promptText="Buscar categoría..."
                               HBox.hgrow="ALWAYS"
                               onKeyReleased="#filtrar"
                               style="-fx-background-color: transparent;
                              -fx-border-color: transparent;
                              -fx-font-size: 13px;
                              -fx-padding: 7 0;"/>
                </HBox>

                <Button fx:id="btnNuevaCategoria" text="➕ Nueva Categoría"
                        styleClass="btn-primary"
                        onAction="#abrirModalCrear"/>
            </HBox>

            <Separator/>

            <TableView fx:id="tablaCategoria" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: transparent;">
                <columns>
                    <TableColumn fx:id="colId"    text="ID"       prefWidth="100"/>
                    <TableColumn fx:id="colNombre" text="Nombre"  prefWidth="300"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="180"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</VBox>

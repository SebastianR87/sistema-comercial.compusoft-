<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.utp.controller.CompraDetalleModalController"
      spacing="0"
      style="-fx-background-color: white;"
      prefWidth="380">

    <!-- CABECERA tipo boleta -->
    <VBox spacing="4" alignment="CENTER"
          style="-fx-background-color: #1a1a2e; -fx-padding: 20 24;">
        <Label text="COMPUSOFT"
               style="-fx-font-size: 18px; -fx-font-weight: bold;
                      -fx-text-fill: white; -fx-letter-spacing: 2px;"/>
        <Label text="Sistema Comercial"
               style="-fx-font-size: 11px;
                      -fx-text-fill: rgba(255,255,255,0.7);"/>
        <Separator style="-fx-padding: 6 0 0 0;"/>
        <Label text="COMPROBANTE DE COMPRA"
               style="-fx-font-size: 12px; -fx-font-weight: bold;
                      -fx-text-fill: #e94560; -fx-padding: 6 0 0 0;
                      -fx-letter-spacing: 1px;"/>
    </VBox>

    <!-- CUERPO -->
    <ScrollPane fitToWidth="true"
                style="-fx-background-color: white; -fx-background: white;
                       -fx-border-color: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="10" style="-fx-padding: 20;">

            <!-- Datos generales -->
            <VBox spacing="4">
                <HBox spacing="8">
                    <Label text="N° Comprobante:"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #6c757d;"/>
                    <Label fx:id="lblComprobante"
                           style="-fx-font-size: 12px; -fx-text-fill: #1a1a2e;"/>
                </HBox>
                <HBox spacing="8">
                    <Label text="Fecha:"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #6c757d;"/>
                    <Label fx:id="lblFecha"
                           style="-fx-font-size: 12px; -fx-text-fill: #1a1a2e;"/>
                </HBox>
                <HBox spacing="8">
                    <Label text="Proveedor:"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #6c757d;"/>
                    <Label fx:id="lblProveedor"
                           style="-fx-font-size: 12px; -fx-text-fill: #1a1a2e;"
                           wrapText="true"/>
                </HBox>
                <HBox spacing="8">
                    <Label text="Atendido por:"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #6c757d;"/>
                    <Label fx:id="lblEmpleado"
                           style="-fx-font-size: 12px; -fx-text-fill: #1a1a2e;"/>
                </HBox>
            </VBox>

            <Separator style="-fx-padding: 4 0;"/>

            <!-- Tabla de productos -->
            <VBox fx:id="panelProductos" spacing="8">
                <!-- Cabecera de la tabla -->
                <HBox spacing="6">
                    <Label text="Producto"
                           style="-fx-font-size: 10px; -fx-font-weight: bold;
                                  -fx-text-fill: #6c757d;"
                           HBox.hgrow="ALWAYS"/>
                    <Label text="Cant."
                           style="-fx-font-size: 10px; -fx-font-weight: bold;
                                  -fx-text-fill: #6c757d;"
                           prefWidth="35" alignment="CENTER_RIGHT"/>
                    <Label text="P.Unit"
                           style="-fx-font-size: 10px; -fx-font-weight: bold;
                                  -fx-text-fill: #6c757d;"
                           prefWidth="55" alignment="CENTER_RIGHT"/>
                    <Label text="Subtotal"
                           style="-fx-font-size: 10px; -fx-font-weight: bold;
                                  -fx-text-fill: #6c757d;"
                           prefWidth="65" alignment="CENTER_RIGHT"/>
                </HBox>
                <Separator/>
                <!-- Las filas de productos se agregan dinámicamente aquí -->
            </VBox>

            <Separator style="-fx-padding: 4 0;"/>

            <!-- Total -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="TOTAL:"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;
                              -fx-text-fill: #1a1a2e;"/>
                <Label fx:id="lblTotal"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;
                              -fx-text-fill: #e94560;"/>
            </HBox>

            <Separator style="-fx-padding: 4 0;"/>

            <!-- Pie -->
            <Label text="Este documento es una representación interna&#10;del registro de compra en el sistema."
                   style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa;
                          -fx-text-alignment: center;"
                   textAlignment="CENTER" wrapText="true"
                   maxWidth="Infinity"/>
        </VBox>
    </ScrollPane>

    <!-- PIE DEL MODAL -->
    <HBox spacing="10" alignment="CENTER_RIGHT"
          style="-fx-padding: 14 20;
                 -fx-background-color: #f8f9fa;
                 -fx-border-color: #e0e0e0 transparent transparent transparent;
                 -fx-border-width: 1;">

        <Button text="✖ Cerrar" onAction="#cerrar"
                style="-fx-background-color: #6c757d; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-cursor: hand;
                       -fx-padding: 8 16; -fx-font-size: 13px;"/>
    </HBox>

</VBox>